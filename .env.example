# Database connection (PostgreSQL / Supabase connection pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Security / JWT
SECRET_KEY=your-secure-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Slow-Order Alerts Configuration (in minutes)
ALERT_THRESHOLD_MINUTES=15
ALERT_REAPPEAR_MINUTES=10
